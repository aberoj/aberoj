# Copy this file to ".env" and fill in your values.

# --- SQL Server connection ---------------------------------------------
# Host name or IP of the PC running SQL Server Express ("localhost" if the
# API runs on the same PC).
DB_SERVER=localhost
# Named instance. SQL Server Express installs as "SQLEXPRESS" by default.
# Leave empty if you set DB_PORT instead.
DB_INSTANCE=SQLEXPRESS
# Optional fixed TCP port (e.g. 1433). If set, DB_INSTANCE is ignored and the
# SQL Server Browser service is not needed.
DB_PORT=
DB_NAME=MyDatabase
# Use the read-only login created by sql/create-readonly-user.sql
DB_USER=api_reader
DB_PASSWORD=change-me
# Set to true only if your SQL Server has a trusted TLS certificate.
DB_ENCRYPT=false

# --- The table to expose -----------------------------------------------
# schema.table (a view works too)
DB_TABLE=dbo.Customers
# Column used by /api/rows/:id. Leave empty to use the table's primary key.
ID_COLUMN=

# --- API settings -------------------------------------------------------
PORT=8080
# 0.0.0.0 listens on all network interfaces so your phone can reach it.
HOST=0.0.0.0
# Optional shared secret. If set, every /api request must send it in the
# "X-API-Key" header (or ?key=...). Strongly recommended.
API_KEY=
# Reject any client whose IP is not a private/LAN address.
LAN_ONLY=true
# Paging limits
DEFAULT_LIMIT=50
MAX_ROWS=500
